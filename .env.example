# Copy this file to `.env` and fill in the values. `.env` is gitignored.
#
#   cp .env.example .env
#
# Nothing here is read by `npm test` or by scripts/concurrency-check.js —
# both are deliberately offline and keyless. Only `node main.js` needs any of it.


# ── Required: without these, `node main.js` cannot do its job ────────────────

# Google AI Studio key for Gemini (model: gemini-2.5-flash).
# This is the one that costs money — every extraction spends tokens against it.
GEMINI_API_KEY=

# Where the extracted tenders are delivered. One POST per city, full list each
# time, body shaped `{ tenders: [...] }`. The receiving side is fixed and must
# not need to change.
WEBHOOK_URL=

# Sent as the `x-webhook-key` header on every delivery.
ELIYAHO_WEBHOOK_KEY=


# ── Optional: alerting. All three, or none ──────────────────────────────────
#
# With any one of them unset, alerting disables itself with a single log line
# and the run is otherwise identical. That is deliberate: a fresh checkout runs
# without anyone signing up for anything.
#
# One digest email per run, sent only when a site's state actually changes —
# a site that stays broken does not mail again the next day.

# From https://resend.com — the free tier is far more than this needs.
RESEND_API_KEY=

# Who gets the digest. One address.
ALERT_EMAIL_TO=

# Who it comes from. `onboarding@resend.dev` works immediately with no domain
# verification, which makes it the right value for a first smoke test; swap in
# an address on your own verified domain once you have one.
ALERT_EMAIL_FROM=onboarding@resend.dev


# ── Optional: tuning. Sensible defaults apply when unset ────────────────────

# How many sites run at once. Default 4. Memory is the real cap — each site
# gets its own Chrome (~150-300MB), which is the price of crash isolation.
# CONCURRENCY=1 reproduces the old strictly-sequential behavior, and is the
# escape hatch if anything about parallelism looks wrong.
CONCURRENCY=4

# Per-site ceiling in milliseconds. Default 300000 (5 min). On expiry the pool
# frees the slot and records the site failed; its cache is left alone, so the
# next run retries it. Set to 0 to disable the timeout entirely.
SITE_TIMEOUT_MS=300000

# Set to 1 to open a visible browser window instead of running headless.
# For demos and debugging only — it does not change what gets scraped.
# HEADFUL=1
